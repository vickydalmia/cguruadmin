# Application runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=1337
APP_PORT=1337
PUBLIC_URL=https://cms.couponzguru.com
TRUST_PROXY=true
TRANSFER_REMOTE_ENABLED=false
# Master switch for cron tasks (5-min coupon/deal status flips + nightly full
# rebuild). Disable on secondary/staging instances to avoid double-flipping.
CRON_ENABLED=true
# Optional Strapi admin UI flags (Net Promoter Score prompt, EE promo banner)
FLAG_NPS=false
FLAG_PROMOTE_EE=false

# Strapi secrets
APP_KEYS=changeMe1,changeMe2,changeMe3,changeMe4
API_TOKEN_SALT=change-me-api-token-salt
ADMIN_JWT_SECRET=change-me-admin-jwt-secret
TRANSFER_TOKEN_SALT=change-me-transfer-token-salt
JWT_SECRET=change-me-jwt-secret
ENCRYPTION_KEY=change-me-32-char-encryption-key

# Database (production must explicitly use PostgreSQL)
DATABASE_CLIENT=postgres
DATABASE_URL=postgres://strapi:change-me-password@db.example.com:5432/strapi
# Alternative to DATABASE_URL — discrete settings (URL wins when both set):
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=change-me
# SQLite fallback for throwaway local experiments only:
# DATABASE_CLIENT=sqlite
# DATABASE_FILENAME=.tmp/data.db
DATABASE_SCHEMA=public
DATABASE_SSL=true
# Use CA for proper verification (DigitalOcean managed DB). Omit to skip verification.
# Option A: path to CA file inside container (mount cert via compose volume)
# DATABASE_SSL_CA_PATH=/opt/app/certs/ca-certificate.crt
# Option B: base64-encoded CA in env (base64 -w 0 ca-certificate.crt)
# DATABASE_SSL_CA=LS0tLS1CRUdJTi...
# Option C: raw PEM with \n for newlines
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\nMII...\n-----END CERTIFICATE-----"
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=60000

# S3 uploads (media is served publicly through media.couponzguru.com)
S3_UPLOAD_ENABLED=true
S3_ACCESS_KEY_ID=change-me-access-key
S3_ACCESS_SECRET=change-me-secret-key
S3_BUCKET=change-me-bucket
S3_REGION=ap-south-1
S3_FORCE_PATH_STYLE=false
S3_BASE_URL=https://media.couponzguru.com
S3_ROOT_PATH=uploads
S3_PREVENT_OVERWRITE=true
S3_CHECKSUM_ALGORITHM=CRC64NVME
S3_MULTIPART_PART_SIZE=10485760
S3_MULTIPART_QUEUE_SIZE=4

# Media library CSP allowlist
UPLOAD_CSP_SOURCES=https://media.couponzguru.com,https://bucket.s3.ap-south-1.amazonaws.com

# CORS: comma-separated browser origins allowed to call Strapi directly.
# Beta/production public visitors call the site origin; the ISR gateway proxies
# search/redeem privately, so leave this empty unless a trusted browser app
# genuinely needs direct CMS API access. Local Astro dev can use http://localhost:4321.
CORS_ORIGINS=

# Frontend rebuild hook: POSTed when cron flips coupon/deal status (and usable
# as the target for admin-configured content webhooks). Leave empty to disable.
BUILD_HOOK_URL=

# ── Event-driven rebuilds (see cguru-ui/docs/static-deployment/deployment-runbook.md) ──
# Master switch: false/unset = scopes are logged only, no builds run
REBUILD_ENABLED=false
# Path to the cguru-ui checkout the worker builds
FRONTEND_DIR=/opt/cguru-ui
# S3 bucket + CloudFront distribution for the static site
SITE_BUCKET=
CLOUDFRONT_DISTRIBUTION_ID=
# Quiet period after the last content change before building (ms)
REBUILD_DEBOUNCE_MS=60000
# Surgical scopes larger than this escalate to a full build
REBUILD_FULL_THRESHOLD=150
# Static fallback only: canonical site origin passed into cguru-ui static builds.
# Redis ISR mode does not read this from Strapi. Uncomment for REBUILD_MODE=static
# or DR snapshot builds. At final go-live, use the final canonical public host.
# PUBLIC_SITE_URL=https://beta.couponzguru.com
STRAPI_MEDIA_URL=https://media.couponzguru.com
# Hard ceiling: build at most this long after a batch's first change,
# even if edits keep flowing (prevents debounce starvation)
REBUILD_MAX_WAIT_MS=300000
# Shared-cache TTL (s) stamped on uploaded HTML — the CloudFront refresh
# window for the STATIC deployment; SWR window is 5x this
REBUILD_HTML_TTL=60

# ── Delivery mode (see cguru-ui/docs/isr-deployment/isr-redis-plan.md) ──
# ISR-FIRST: unset/redis (default) = worker POSTs scopes to the ISR gateway
# /revalidate (pages re-render into Redis, live in ~5-70s).
# Set REBUILD_MODE=static explicitly for S3 static deploys (DR snapshots /
# fallback rollout — needs FRONTEND_DIR/SITE_BUCKET/CLOUDFRONT_* above).
REBUILD_MODE=redis
ISR_GATEWAY_URL=http://<ASTRO_PRIVATE_IP>:3010
# Must match the gateway's ISR_REVALIDATE_SECRET (openssl rand -hex 32)
ISR_REVALIDATE_SECRET=
