# Application runtime
APP_IMAGE=ghcr.io/vickydalmia/cguruadmin
APP_IMAGE_TAG=1.0.0
NODE_ENV=production
HOST=0.0.0.0
PORT=1337
APP_PORT=1337
# Host publish addresses for APP_PORT. The compose file ALWAYS publishes on
# 127.0.0.1 (loopback) and ADDITIONALLY on APP_BIND. On the droplet set
# APP_BIND to this droplet's DO VPC private IP so the Astro origin can reach
# Strapi for ISR warm/revalidate. REQUIRED on the droplet (deploy fails loudly
# if unset). NEVER 0.0.0.0 — Docker publishes past ufw, exposing the admin/API
# publicly; restrict :1337 to the Astro droplet's private IP in the DO Cloud
# Firewall as well.
APP_BIND=10.139.0.6
# Comma-separated IPs (exact, or prefixes ending in '.') whose requests BYPASS
# the per-IP API rate limits. Set to the Astro origin's DO VPC private IP (or
# the whole VPC prefix, e.g. `10.139.0.`) so ISR warm-up after a frontend
# deploy isn't throttled with 429s — the warm-up fires hundreds of requests
# per minute from that single IP. The same allowlist is required for signed ISR
# response-cache bypasses. Matched against the raw TCP socket address (never
# X-Forwarded-For), so public clients cannot spoof their way in.
RATE_LIMIT_TRUSTED_IPS=10.139.0.
PUBLIC_URL=https://cms.example.com
TRUST_PROXY=true
TRANSFER_REMOTE_ENABLED=false
# Master switch for cron tasks (5-min coupon/deal status flips + nightly full
# rebuild). Disable on secondary/staging instances to avoid double-flipping.
CRON_ENABLED=true
# Optional Strapi admin UI flags (Net Promoter Score prompt, EE promo banner)
FLAG_NPS=false
FLAG_PROMOTE_EE=false
# Emit structured timing logs for CMS searches at or above this duration.
# Set 0 to disable the slow-search log.
SEARCH_SLOW_LOG_MS=500

# Strapi secrets
APP_KEYS=changeMe1,changeMe2,changeMe3,changeMe4
API_TOKEN_SALT=change-me-api-token-salt
ADMIN_JWT_SECRET=change-me-admin-jwt-secret
TRANSFER_TOKEN_SALT=change-me-transfer-token-salt
JWT_SECRET=change-me-jwt-secret
ENCRYPTION_KEY=change-me-32-char-encryption-key

# Database (local PostgreSQL; default postgres user/database, no password)
DATABASE_CLIENT=postgres
DATABASE_URL=postgres://postgres@127.0.0.1:5432/postgres
# Alternative to DATABASE_URL — discrete settings (URL wins when both set):
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# DATABASE_NAME=postgres
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=
# SQLite fallback for throwaway local experiments only:
# DATABASE_CLIENT=sqlite
# DATABASE_FILENAME=.tmp/data.db
DATABASE_SCHEMA=public
DATABASE_SSL=false
# Production managed PostgreSQL should set DATABASE_URL, enable SSL, and use
# the provider CA for proper verification.
# Option A: path to CA file inside container (mount cert via compose volume)
# DATABASE_SSL_CA_PATH=/opt/app/certs/ca-certificate.crt
# Option B: base64-encoded CA in env (base64 -w 0 ca-certificate.crt)
# DATABASE_SSL_CA=LS0tLS1CRUdJTi...
# Option C: raw PEM with \n for newlines
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\nMII...\n-----END CERTIFICATE-----"
# Advanced mutual-TLS/cipher options, normally left unset:
# DATABASE_SSL_KEY=
# DATABASE_SSL_CERT=
# DATABASE_SSL_CAPATH=
# DATABASE_SSL_CIPHER=
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=60000

# S3 uploads (replace the example host with this deployment's media CDN)
S3_UPLOAD_ENABLED=true
S3_ACCESS_KEY_ID=change-me-access-key
S3_ACCESS_SECRET=change-me-secret-key
S3_BUCKET=change-me-bucket
S3_REGION=ap-south-1
S3_FORCE_PATH_STYLE=false
S3_BASE_URL=https://media.example.com
S3_ROOT_PATH=uploads
S3_PREVENT_OVERWRITE=true
S3_CHECKSUM_ALGORITHM=CRC64NVME
S3_MULTIPART_PART_SIZE=10485760
S3_MULTIPART_QUEUE_SIZE=4

# Transparent Product Deal images (server-side only; never expose this key to the admin bundle)
FAL_KEY=change-me-fal-key
FAL_BACKGROUND_REMOVAL_CONCURRENCY=2
FAL_BACKGROUND_REMOVAL_TIMEOUT_MS=120000
FAL_BACKGROUND_REMOVAL_MAX_ATTEMPTS=3

# Media library CSP allowlist
UPLOAD_CSP_SOURCES=https://media.example.com,https://example-bucket.s3.ap-south-1.amazonaws.com

# CORS: comma-separated browser origins allowed to call Strapi directly.
# Beta/production public visitors call the site origin; the ISR gateway proxies
# search/redeem privately, so leave this empty unless a trusted browser app
# genuinely needs direct CMS API access. Local Astro dev can use http://localhost:4321.
CORS_ORIGINS=

# Required runtime storefront origin. One generic CMS image serves every
# country: the authenticated admin runtime-config endpoint supplies this value
# to Coupon/Deal "Copy public link" actions, while server-side rich-text
# sanitization derives the first-party registrable domain from it. It is never
# compiled into the admin bundle and there is no INTERNAL_HOSTS variable.
PUBLIC_SITE_URL=https://www.example.com

# ── Persistent ISR transactional outbox ──
ISR_GATEWAY_URL=http://<ASTRO_PRIVATE_IP>:3010
# Must match the gateway's ISR_ADMIN_SECRET (use at least 32 random bytes).
ISR_ADMIN_SECRET=
# Enable on exactly one process. When omitted it inherits CRON_ENABLED; Compose
# also overrides it explicitly to false for strapi-render.
ISR_OUTBOX_DISPATCHER_ENABLED=true
ISR_OUTBOX_POLL_MS=2000
ISR_OUTBOX_BATCH_SIZE=25
ISR_OUTBOX_REQUEST_TIMEOUT_MS=90000
ISR_OUTBOX_LEASE_MS=120000
ISR_OUTBOX_MAX_BACKOFF_MS=300000
ISR_OUTBOX_ALERT_AFTER_ATTEMPTS=5
# Alert + unhealthy /api/isr/status when the oldest undelivered event is older.
ISR_OUTBOX_BACKLOG_ALERT_MS=1800000
ISR_OUTBOX_RETENTION_DAYS=30
ISR_REVALIDATE_MAX_PATHS=5000
ISR_OUTBOX_MAX_PAYLOAD_BYTES=900000
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_DEFAULT_FROM=contact@example.com
EMAIL_DEFAULT_REPLY_TO=contact@example.com

# ── AI content translation (server-side only; never expose the key to the admin bundle) ──
# Inert unless Country Setup ALSO enables it (translationEnabled + the
# Target languages multi-select, any ISO 639-1 code ICU can name, e.g. "ar")
# — India/USA deployments leave this whole block unset. Saving Country Setup
# hot-applies to the CMS instance that took the save (locale creation +
# dispatcher start); other CMS containers pick the change up at their next
# restart. The block itself is read at boot and on that hot-apply only.
#
# TRANSLATION_PROVIDER: "openai" for the official Responses API (including
# gpt-5.6-luna), "openai-compatible" for a /chat/completions vendor such as
# OpenRouter, Groq, DeepSeek, Gemini's compat endpoint or a private gateway,
# or "anthropic" for the native Messages API. All three use AI SDK adapters;
# SDK retries are disabled so the durable translation ledger owns each attempt.
TRANSLATION_PROVIDER=
TRANSLATION_API_KEY=
# Required for openai-compatible (e.g. https://openrouter.ai/api/v1).
# Optional API-prefix override for openai;
# optional host override for anthropic. Leave empty for official endpoints.
TRANSLATION_BASE_URL=
TRANSLATION_MODEL=
# Official OpenAI Responses only: none|low|medium|high|xhigh|max. `none` is
# recommended for the first translation backfill; raise only if quality-gate
# failures demonstrate that more reasoning is worth the additional cost.
TRANSLATION_REASONING_EFFORT=none
# Parallel LLM calls across all jobs; keep small — provider rate limits.
TRANSLATION_CONCURRENCY=2
TRANSLATION_TIMEOUT_MS=120000
TRANSLATION_MAX_ATTEMPTS=3
TRANSLATION_MAX_OUTPUT_TOKENS=8192
TRANSLATION_CHUNK_CHARS=12000
# Hard daily spend stop in USD (0 disables). Translation uses a target-language
# writer and an independent copy-editor, plus at most one corrective call per
# failed stage (content entries and the storefront UI-text dictionary alike).
# Positive per-MTok rates below are required when this budget is enabled;
# the concurrency-safe usage ledger resets at UTC midnight.
TRANSLATION_DAILY_BUDGET_USD=0
TRANSLATION_INPUT_COST_PER_MTOK=0
TRANSLATION_OUTPUT_COST_PER_MTOK=0
# Job queue knobs (mirror the ISR_OUTBOX_* family; defaults are sane).
TRANSLATION_OUTBOX_POLL_MS=5000
TRANSLATION_OUTBOX_BATCH_SIZE=5
TRANSLATION_OUTBOX_LEASE_MS=900000
TRANSLATION_OUTBOX_MAX_BACKOFF_MS=21600000
TRANSLATION_OUTBOX_RETENTION_DAYS=30
TRANSLATION_OUTBOX_ALERT_AFTER_ATTEMPTS=5
TRANSLATION_OUTBOX_BACKLOG_ALERT_MS=3600000
TRANSLATION_RELATION_RETRY_MAX=5
