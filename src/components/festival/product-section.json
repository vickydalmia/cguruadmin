{
  "collectionName": "components_festival_product_sections",
  "info": {
    "displayName": "Picked for you \u00b7 Product Deals",
    "icon": "slideshow"
  },
  "attributes": {
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "heading": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 240
    },
    "items": {
      "type": "component",
      "repeatable": true,
      "component": "festival.product-slide"
    },
    "categories": {
      "type": "component",
      "repeatable": true,
      "component": "festival.product-category"
    },
    "listingEnabled": {
      "type": "boolean",
      "default": true
    },
    "filterBrands": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::brand.brand"
    },
    "filterStores": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::store.store"
    },
    "filterBanks": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::bank.bank"
    }
  }
}
