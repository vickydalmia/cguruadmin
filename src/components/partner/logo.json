{
  "collectionName": "components_partner_logos",
  "info": {
    "displayName": "Partner Logo",
    "icon": "picture",
    "description": "One trusted-brand logo. A populated logo list replaces the committed fallback list."
  },
  "attributes": {
    "name": { "type": "string", "required": true, "maxLength": 100 },
    "image": { "type": "media", "multiple": false, "required": true, "allowedTypes": ["images"] },
    "imageAlt": { "type": "string", "maxLength": 180 },
    "row": { "type": "integer", "default": 1, "min": 1, "max": 2 },
    "tone": { "type": "enumeration", "enum": ["white", "blue", "red", "black", "outlined"], "default": "white" }
  }
}
