{
  "collectionName": "components_homepage_slider_slides",
  "info": {
    "displayName": "Slider Slide",
    "icon": "picture"
  },
  "attributes": {
    "desktopImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "link": {
      "type": "string",
      "maxLength": 500,
      "regex": "^(?:/(?!/)[^\\s\\\\]*|https?://[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?([.][a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?)+(:[0-9]{1,5})?([/?#]\\S*)?)$"
    },
    "altText": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
