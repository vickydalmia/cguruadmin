{
  "collectionName": "components_header_search_suggestions",
  "info": {
    "displayName": "Search Suggestion",
    "icon": "link"
  },
  "attributes": {
    "text": {
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "url": {
      "type": "string",
      "required": true,
      "maxLength": 500,
      "regex": "^(?:/(?!/)\\S*|https?://[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?([.][a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?)+(:[0-9]{1,5})?([/?#]\\S*)?)$"
    }
  }
}
