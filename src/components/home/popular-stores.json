{
  "collectionName": "components_home_popular_stores",
  "info": {
    "displayName": "Popular Stores & Brands Section",
    "icon": "store"
  },
  "attributes": {
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "heading": {
      "type": "string"
    },
    "viewAllCta": {
      "type": "component",
      "repeatable": false,
      "component": "shared.cta"
    },
    "featuredStore": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::store.store"
    },
    "stores": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::store.store"
    },
    "brands": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::brand.brand"
    }
  }
}
