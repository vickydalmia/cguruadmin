{
  "kind": "collectionType",
  "collectionName": "banks",
  "info": {
    "singularName": "bank",
    "pluralName": "banks",
    "displayName": "Bank",
    "description": "Financial institutions (HDFC, ICICI, SBI Card, Axis Bank)"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "string",
      "required": true,
      "regex": "^[a-z0-9]+([-.][a-z0-9]+)*$"
    },
    "pageTemplate": {
      "type": "enumeration",
      "enum": [
        "default",
        "dealTemplate",
        "independenceDayTemplate"
      ],
      "default": "default",
      "required": true
    },
    "description": {
      "type": "richtext",
      "searchable": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "shortDescription": {
      "type": "text",
      "required": true,
      "searchable": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "logo": {
      "type": "media",
      "required": true,
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "logoAlt": {
      "type": "string",
      "required": true,
      "searchable": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "websiteUrl": {
      "type": "string",
      "regex": "^https?://[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?([.][a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?)+(:[0-9]{1,5})?([/?#]\\S*)?$",
      "searchable": false
    },
    "ratingAverage": {
      "type": "decimal",
      "min": 0,
      "max": 5
    },
    "ratingCount": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "isVerified": {
      "type": "boolean",
      "default": false
    },
    "showTrendingDeals": {
      "type": "boolean",
      "default": true
    },
    "coupons": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::coupon.coupon",
      "mappedBy": "banks"
    },
    "deals": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::deal.deal",
      "mappedBy": "banks"
    },
    "topPickCoupons": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::coupon.coupon"
    },
    "orderedCoupons": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::coupon.coupon"
    },
    "faqEnabled": {
      "type": "boolean",
      "default": false
    },
    "faqs": {
      "type": "component",
      "repeatable": true,
      "component": "shared.faq-item",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "entityDealPageSeo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.entity-deal-page-seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  }
}
