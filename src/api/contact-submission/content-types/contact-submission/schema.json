{
  "kind": "collectionType",
  "collectionName": "contact_submissions",
  "info": {
    "singularName": "contact-submission",
    "pluralName": "contact-submissions",
    "displayName": "Contact Submission",
    "description": "Messages submitted from the public Contact page. Public core routes are not exposed."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "fullName": {
      "type": "string",
      "required": true,
      "maxLength": 120
    },
    "email": {
      "type": "email",
      "required": true
    },
    "topic": {
      "type": "string",
      "required": true,
      "maxLength": 100
    },
    "message": {
      "type": "text",
      "maxLength": 2000
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "new",
        "reviewing",
        "responded",
        "spam",
        "archived"
      ],
      "default": "new"
    }
  }
}
