{
  "kind": "collectionType",
  "collectionName": "coupons",
  "info": {
    "singularName": "coupon",
    "pluralName": "coupons",
    "displayName": "Coupon",
    "description": "Coupon codes (static and unique) for stores, banks, categories, and brands"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "content": {
      "type": "richtext"
    },
    "code": {
      "type": "text"
    },
    "couponType": {
      "type": "enumeration",
      "required": true,
      "default": "static",
      "enum": [
        "static",
        "unique"
      ]
    },
    "uniqueCouponPool": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::unique-coupon-pool.unique-coupon-pool",
      "inversedBy": "coupons"
    },
    "isPopular": {
      "type": "boolean",
      "default": false
    },
    "offerType": {
      "type": "enumeration",
      "enum": [
        "exclusive",
        "newly_added",
        "electronics",
        "fashion",
        "travel",
        "food"
      ]
    },
    "cashbackItems": {
      "type": "component",
      "repeatable": true,
      "component": "shared.chip"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "affiliateLink": {
      "type": "text"
    },
    "expiresAt": {
      "type": "datetime"
    },
    "scheduledAt": {
      "type": "datetime"
    },
    "contentStatus": {
      "type": "enumeration",
      "required": true,
      "default": "published",
      "enum": [
        "published",
        "scheduled",
        "expired"
      ]
    },
    "stores": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::store.store",
      "inversedBy": "coupons"
    },
    "banks": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::bank.bank",
      "inversedBy": "coupons"
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "inversedBy": "coupons"
    },
    "brands": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::brand.brand",
      "inversedBy": "coupons"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag",
      "inversedBy": "coupons"
    }
  }
}
