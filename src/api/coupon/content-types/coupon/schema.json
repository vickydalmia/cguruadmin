{
  "kind": "collectionType",
  "collectionName": "coupons",
  "info": {
    "singularName": "coupon",
    "pluralName": "coupons",
    "displayName": "Coupon",
    "description": "Coupon codes (static and unique) for stores, banks, categories, and brands"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 200
    },
    "offerText": {
      "type": "string",
      "required": true
    },
    "content": {
      "type": "richtext",
      "required": true,
      "maxLength": 50000
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "couponType"
            },
            "static"
          ]
        }
      }
    },
    "couponType": {
      "type": "enumeration",
      "required": true,
      "default": "static",
      "enum": [
        "static",
        "unique"
      ]
    },
    "uniqueCouponPool": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::unique-coupon-pool.unique-coupon-pool",
      "inversedBy": "coupons",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "couponType"
            },
            "unique"
          ]
        }
      }
    },
    "badge": {
      "type": "enumeration",
      "enum": [
        "CG Exclusive",
        "Recommended",
        "Top Rated",
        "Best Seller",
        "Expiring Soon",
        "LOOT Deal"
      ]
    },
    "cashbackText": {
      "type": "string"
    },
    "bankOfferText": {
      "type": "string"
    },
    "prepaidText": {
      "type": "string"
    },
    "affiliateLink": {
      "type": "text",
      "required": true,
      "regex": "^https?://[^\\u0000-\\u001f\\u007f<>]+$"
    },
    "expiresAt": {
      "type": "datetime"
    },
    "scheduledAt": {
      "type": "datetime"
    },
    "publishedOn": {
      "type": "datetime"
    },
    "contentStatus": {
      "type": "enumeration",
      "required": true,
      "default": "published",
      "enum": [
        "published",
        "scheduled",
        "expired"
      ]
    },
    "workedCount": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "failedCount": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "stores": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::store.store",
      "inversedBy": "coupons"
    },
    "logoStore": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::store.store"
    },
    "banks": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::bank.bank",
      "inversedBy": "coupons"
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "inversedBy": "coupons"
    },
    "brands": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::brand.brand",
      "inversedBy": "coupons"
    }
  }
}
