{
  "kind": "singleType",
  "collectionName": "menus",
  "info": {
    "singularName": "menu",
    "pluralName": "menus",
    "displayName": "Header Settings",
    "description": "Site header navigation, search suggestions, and active notifications"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": "Header Settings",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "notification": {
      "type": "component",
      "component": "header.notification",
      "repeatable": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "topStores": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::store.store",
      "max": 18
    },
    "topStoresLabel": {
      "type": "string",
      "default": "Top Stores",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "topStoresTitle": {
      "type": "string",
      "default": "All Stores",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "topStoresViewAllUrl": {
      "type": "string",
      "default": "/stores/"
    },
    "topBrands": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::brand.brand",
      "max": 18
    },
    "topBrandsLabel": {
      "type": "string",
      "default": "Top Brands",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "topBrandsTitle": {
      "type": "string",
      "default": "All Brands",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "topBrandsViewAllUrl": {
      "type": "string",
      "default": "/brands/"
    },
    "searchTopStores": {
      "type": "component",
      "repeatable": true,
      "component": "header.search-top-store",
      "max": 8,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "searchSuggestions": {
      "type": "component",
      "repeatable": true,
      "component": "header.search-suggestion",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "categoriesLabel": {
      "type": "string",
      "default": "Categories",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "categoriesTitle": {
      "type": "string",
      "default": "All Categories",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "categoriesPopularStoresTitle": {
      "type": "string",
      "default": "Popular Stores",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "categoriesViewAllUrl": {
      "type": "string",
      "default": "/categories/",
      "maxLength": 500,
      "regex": "^(?:/(?!/)\\S*|https?://[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?([.][a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?)+(:[0-9]{1,5})?([/?#]\\S*)?)$"
    },
    "categorySections": {
      "type": "component",
      "repeatable": true,
      "component": "nav.category-section",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "extraItems": {
      "type": "component",
      "repeatable": true,
      "component": "nav.link",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  }
}
