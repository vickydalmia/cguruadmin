{
  "kind": "singleType",
  "collectionName": "menus",
  "info": {
    "singularName": "menu",
    "pluralName": "menus",
    "displayName": "Header Settings",
    "description": "Site header navigation, search suggestions, and active notifications"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": "Header Settings"
    },
    "notification": {
      "type": "component",
      "component": "header.notification",
      "repeatable": false
    },
    "topStores": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::store.store",
      "max": 18
    },
    "topStoresLabel": {
      "type": "string",
      "default": "Top Stores"
    },
    "topStoresTitle": {
      "type": "string",
      "default": "All Stores"
    },
    "topStoresViewAllUrl": {
      "type": "string",
      "default": "/stores/"
    },
    "searchTopStores": {
      "type": "component",
      "repeatable": true,
      "component": "header.search-top-store",
      "max": 8
    },
    "searchSuggestions": {
      "type": "component",
      "repeatable": true,
      "component": "header.search-suggestion"
    },
    "categoriesLabel": {
      "type": "string",
      "default": "Categories"
    },
    "categoriesTitle": {
      "type": "string",
      "default": "All Categories"
    },
    "categoriesPopularStoresTitle": {
      "type": "string",
      "default": "Popular Stores"
    },
    "categoriesViewAllUrl": {
      "type": "string",
      "default": "/categories/",
      "maxLength": 500,
      "regex": "^(?:/(?!/)\\S*|https?://[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?([.][a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?)+(:[0-9]{1,5})?([/?#]\\S*)?)$"
    },
    "categorySections": {
      "type": "component",
      "repeatable": true,
      "component": "nav.category-section"
    },
    "extraItems": {
      "type": "component",
      "repeatable": true,
      "component": "nav.link"
    }
  }
}
