{
  "kind": "singleType",
  "collectionName": "about_pages",
  "info": {
    "singularName": "about-page",
    "pluralName": "about-pages",
    "displayName": "About Page",
    "description": "Every piece of copy, image and link on the public /about-us/ page. Sections render in the fixed order shown here; each can be switched off with its own Enabled toggle."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "default": "About Page"
    },
    "breadcrumbAriaLabel": {
      "type": "string",
      "default": "Breadcrumb",
      "maxLength": 60
    },
    "breadcrumbItems": {
      "type": "component",
      "repeatable": true,
      "component": "shared.breadcrumb-item",
      "max": 5
    },
    "hero": {
      "type": "component",
      "repeatable": false,
      "component": "about.hero"
    },
    "ourStory": {
      "type": "component",
      "repeatable": false,
      "component": "about.our-story"
    },
    "journey": {
      "type": "component",
      "repeatable": false,
      "component": "about.journey"
    },
    "missionVision": {
      "type": "component",
      "repeatable": false,
      "component": "about.mission-vision"
    },
    "trust": {
      "type": "component",
      "repeatable": false,
      "component": "about.trust"
    },
    "founder": {
      "type": "component",
      "repeatable": false,
      "component": "about.founder"
    },
    "press": {
      "type": "component",
      "repeatable": false,
      "component": "about.press"
    },
    "international": {
      "type": "component",
      "repeatable": false,
      "component": "about.international"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
