{
  "kind": "singleType",
  "collectionName": "about_pages",
  "info": {
    "singularName": "about-page",
    "pluralName": "about-pages",
    "displayName": "About Page",
    "description": "Every piece of copy, image and link on the public /about-us/ page. Sections render in the fixed order shown here; each can be switched off with its own Enabled toggle."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": "About Page",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "breadcrumbAriaLabel": {
      "type": "string",
      "default": "Breadcrumb",
      "maxLength": 60,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "breadcrumbItems": {
      "type": "component",
      "repeatable": true,
      "component": "shared.breadcrumb-item",
      "max": 5,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "hero": {
      "type": "component",
      "repeatable": false,
      "component": "about.hero",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "ourStory": {
      "type": "component",
      "repeatable": false,
      "component": "about.our-story",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "journey": {
      "type": "component",
      "repeatable": false,
      "component": "about.journey",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "missionVision": {
      "type": "component",
      "repeatable": false,
      "component": "about.mission-vision",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "trust": {
      "type": "component",
      "repeatable": false,
      "component": "about.trust",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "founder": {
      "type": "component",
      "repeatable": false,
      "component": "about.founder",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "press": {
      "type": "component",
      "repeatable": false,
      "component": "about.press",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "international": {
      "type": "component",
      "repeatable": false,
      "component": "about.international",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
