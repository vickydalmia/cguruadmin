{
  "kind": "collectionType",
  "collectionName": "deals",
  "info": {
    "singularName": "deal",
    "pluralName": "deals",
    "displayName": "Deal",
    "description": "Product deals with pricing, images, and affiliate links"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "content": {
      "type": "richtext"
    },
    "excerpt": {
      "type": "text"
    },
    "code": {
      "type": "text"
    },
    "dealImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "salePrice": {
      "type": "decimal"
    },
    "mrp": {
      "type": "decimal"
    },
    "discount": {
      "type": "string"
    },
    "isPopular": {
      "type": "boolean",
      "default": false
    },
    "affiliateLink": {
      "type": "text"
    },
    "expiresAt": {
      "type": "datetime"
    },
    "scheduledAt": {
      "type": "datetime"
    },
    "contentStatus": {
      "type": "enumeration",
      "required": true,
      "default": "published",
      "enum": [
        "published",
        "scheduled",
        "expired"
      ]
    },
    "stores": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::store.store",
      "inversedBy": "deals"
    },
    "banks": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::bank.bank",
      "inversedBy": "deals"
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "inversedBy": "deals"
    },
    "brands": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::brand.brand",
      "inversedBy": "deals"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag",
      "inversedBy": "deals"
    }
  }
}
