{
  "kind": "collectionType",
  "collectionName": "deals",
  "info": {
    "singularName": "deal",
    "pluralName": "deals",
    "displayName": "Product Deal",
    "description": "Product deals with pricing, images, and affiliate links"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 200
    },
    "content": {
      "type": "richtext",
      "maxLength": 50000
    },
    "code": {
      "type": "text",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "couponType"
            },
            "static"
          ]
        }
      }
    },
    "couponType": {
      "type": "enumeration",
      "required": true,
      "default": "static",
      "enum": [
        "static",
        "unique"
      ]
    },
    "uniqueCouponPool": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::unique-coupon-pool.unique-coupon-pool",
      "inversedBy": "deals",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "couponType"
            },
            "unique"
          ]
        }
      }
    },
    "dealImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "salePrice": {
      "type": "decimal",
      "min": 0
    },
    "mrp": {
      "type": "decimal",
      "min": 0
    },
    "discount": {
      "type": "string"
    },
    "badge": {
      "type": "enumeration",
      "enum": [
        "CG Exclusive",
        "Recommended",
        "Top Rated",
        "Best Seller",
        "Expiring Soon",
        "LOOT Deal"
      ]
    },
    "cashbackText": {
      "type": "string"
    },
    "bankOfferText": {
      "type": "string"
    },
    "prepaidText": {
      "type": "string"
    },
    "affiliateLink": {
      "type": "text",
      "required": true,
      "regex": "^https?://[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?([.][a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?)+(:[0-9]{1,5})?([/?#]\\S*)?$"
    },
    "expiresAt": {
      "type": "datetime"
    },
    "scheduledAt": {
      "type": "datetime"
    },
    "publishedOn": {
      "type": "datetime"
    },
    "contentStatus": {
      "type": "enumeration",
      "required": true,
      "default": "published",
      "enum": [
        "published",
        "scheduled",
        "expired"
      ]
    },
    "workedCount": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "failedCount": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "stores": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::store.store",
      "inversedBy": "deals"
    },
    "banks": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::bank.bank",
      "inversedBy": "deals"
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "inversedBy": "deals"
    },
    "brands": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::brand.brand",
      "inversedBy": "deals"
    }
  }
}
