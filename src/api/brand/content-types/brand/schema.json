{
  "kind": "collectionType",
  "collectionName": "brands",
  "info": {
    "singularName": "brand",
    "pluralName": "brands",
    "displayName": "Brand",
    "description": "Brands (Nike, Samsung, Apple, Levi's)"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "regex": "^[a-z0-9]+([-.][a-z0-9]+)*$"
    },
    "description": {
      "type": "richtext",
      "searchable": false
    },
    "shortDescription": {
      "type": "text",
      "required": true,
      "searchable": false
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "logoAlt": {
      "type": "string",
      "required": true,
      "searchable": false
    },
    "websiteUrl": {
      "type": "string",
      "regex": "^https?://[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?([.][a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?)+(:[0-9]{1,5})?([/?#]\\S*)?$",
      "searchable": false
    },
    "ratingAverage": {
      "type": "decimal",
      "min": 0,
      "max": 5
    },
    "ratingCount": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "isVerified": {
      "type": "boolean",
      "default": false
    },
    "coupons": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::coupon.coupon",
      "mappedBy": "brands"
    },
    "deals": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::deal.deal",
      "mappedBy": "brands"
    },
    "topPickCoupons": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::coupon.coupon"
    },
    "faqEnabled": {
      "type": "boolean",
      "default": false
    },
    "faqs": {
      "type": "component",
      "repeatable": true,
      "component": "shared.faq-item"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
