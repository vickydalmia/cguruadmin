{
  "kind": "singleType",
  "collectionName": "contact_pages",
  "info": {
    "singularName": "contact-page",
    "pluralName": "contact-pages",
    "displayName": "Contact Page",
    "description": "All editable copy, contact links, form options, hero media and SEO for the public /contact-us/ page."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": "Contact Us",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "breadcrumbAriaLabel": {
      "type": "string",
      "default": "Breadcrumb",
      "maxLength": 60,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "breadcrumbItems": {
      "type": "component",
      "repeatable": true,
      "component": "shared.breadcrumb-item",
      "max": 5,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "hero": {
      "type": "component",
      "repeatable": false,
      "component": "contact.hero",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "contactInformationHeading": {
      "type": "string",
      "maxLength": 100,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "contactMethods": {
      "type": "component",
      "repeatable": true,
      "component": "contact.contact-method",
      "max": 3,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "form": {
      "type": "component",
      "repeatable": false,
      "component": "contact.form",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
