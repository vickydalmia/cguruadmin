{
  "kind": "singleType",
  "collectionName": "affiliate_disclosure_pages",
  "info": {
    "singularName": "affiliate-disclosure-page",
    "pluralName": "affiliate-disclosure-pages",
    "displayName": "Affiliate Disclosure Page",
    "description": "Editable copy, ordered disclosure sections and SEO for the public /affiliate-disclosure/ page. This document renders in the full-width layout, so navigationItems and supportCta are unused by the storefront and are kept only for parity with the other legal single types."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": "Affiliate Disclosure",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "breadcrumbAriaLabel": {
      "type": "string",
      "default": "Breadcrumb",
      "maxLength": 60,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "breadcrumbItems": {
      "type": "component",
      "repeatable": true,
      "component": "shared.breadcrumb-item",
      "max": 5,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "eyebrow": {
      "type": "string",
      "maxLength": 60,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "heading": {
      "type": "string",
      "maxLength": 100,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "effectiveDate": {
      "type": "string",
      "maxLength": 100,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "contentHeading": {
      "type": "string",
      "maxLength": 160,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "navigationTitle": {
      "type": "string",
      "maxLength": 80,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "navigationItems": {
      "type": "component",
      "repeatable": true,
      "component": "legal.navigation-item",
      "max": 12,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "supportCta": {
      "type": "component",
      "repeatable": false,
      "component": "legal.support-cta",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "sections": {
      "type": "component",
      "repeatable": true,
      "component": "legal.section",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
