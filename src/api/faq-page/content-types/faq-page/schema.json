{
  "kind": "singleType",
  "collectionName": "faq_pages",
  "info": {
    "singularName": "faq-page",
    "pluralName": "faq-pages",
    "displayName": "FAQ Page",
    "description": "All editable copy, categories, questions and SEO for the public /faqs/ page. Category and question order follows the order configured here."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": "FAQ Page",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "breadcrumbAriaLabel": {
      "type": "string",
      "default": "Breadcrumb",
      "maxLength": 60,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "breadcrumbItems": {
      "type": "component",
      "repeatable": true,
      "component": "shared.breadcrumb-item",
      "max": 5,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "eyebrow": {
      "type": "string",
      "maxLength": 60,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "heading": {
      "type": "string",
      "maxLength": 100,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "text",
      "maxLength": 320,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "searchPlaceholder": {
      "type": "string",
      "maxLength": 80,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "noResultsMessage": {
      "type": "string",
      "maxLength": 160,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "categories": {
      "type": "component",
      "repeatable": true,
      "component": "faq.category",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "supportCta": {
      "type": "component",
      "repeatable": false,
      "component": "faq.support-cta",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
