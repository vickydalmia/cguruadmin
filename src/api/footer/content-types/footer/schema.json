{
  "kind": "singleType",
  "collectionName": "footers",
  "info": {
    "singularName": "footer",
    "pluralName": "footers",
    "displayName": "Footer",
    "description": "Footer link sections, socials, countries, partner and Google Preferred cards"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": "Footer"
    },
    "sections": {
      "type": "component",
      "repeatable": true,
      "component": "footer.link-section"
    },
    "socialLinks": {
      "type": "component",
      "repeatable": true,
      "component": "footer.social-link"
    },
    "countries": {
      "type": "component",
      "repeatable": true,
      "component": "footer.country"
    },
    "partnerCard": {
      "type": "component",
      "repeatable": false,
      "component": "footer.partner-card"
    },
    "googlePreferredCard": {
      "type": "component",
      "repeatable": false,
      "component": "footer.google-preferred-card"
    },
    "badgeText": {
      "type": "string"
    },
    "copyrightText": {
      "type": "string"
    }
  }
}
