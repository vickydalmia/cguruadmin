{
  "kind": "singleType",
  "collectionName": "footers",
  "info": {
    "singularName": "footer",
    "pluralName": "footers",
    "displayName": "Footer",
    "description": "Footer link sections, socials, countries, partner and Google Preferred cards"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": "Footer",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "sections": {
      "type": "component",
      "repeatable": true,
      "component": "footer.link-section",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "socialLinks": {
      "type": "component",
      "repeatable": true,
      "component": "footer.social-link",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "countries": {
      "type": "component",
      "repeatable": true,
      "component": "footer.country",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "partnerCard": {
      "type": "component",
      "repeatable": false,
      "component": "footer.partner-card",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "googlePreferredCard": {
      "type": "component",
      "repeatable": false,
      "component": "footer.google-preferred-card",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "badgeText": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "copyrightText": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  }
}
