{
  "kind": "singleType",
  "collectionName": "career_pages",
  "info": {
    "singularName": "career-page",
    "pluralName": "career-pages",
    "displayName": "Career Page",
    "description": "All editable copy and media shared by the Careers listing and job detail pages. Missing fields use the deployed Figma fallback."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": "Career Page",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "homeBreadcrumbLabel": {
      "type": "string",
      "default": "Home",
      "maxLength": 60,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "careersBreadcrumbLabel": {
      "type": "string",
      "default": "Careers",
      "maxLength": 60,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "hero": {
      "type": "component",
      "repeatable": false,
      "component": "career.hero",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "whyJoinHeader": {
      "type": "component",
      "repeatable": false,
      "component": "shared.section-header",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "benefits": {
      "type": "component",
      "repeatable": true,
      "component": "career.benefit-card",
      "max": 4,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "values": {
      "type": "component",
      "repeatable": true,
      "component": "career.value-card",
      "max": 4,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "jobsSection": {
      "type": "component",
      "repeatable": false,
      "component": "career.jobs-section",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "life": {
      "type": "component",
      "repeatable": false,
      "component": "career.life",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "jobDetail": {
      "type": "component",
      "repeatable": false,
      "component": "career.job-detail-copy",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  }
}
