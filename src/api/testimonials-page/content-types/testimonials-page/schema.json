      "default": "Breadcrumb",
      "maxLength": 60
    },
    "breadcrumbItems": {
      "type": "component",
      "repeatable": true,
      "component": "shared.breadcrumb-item",
      "max": 5
    },
    "hero": {
      "type": "component",
      "repeatable": false,
      "component": "testimonial.hero"
    },
    "featured": {
      "type": "component",
      "repeatable": false,
      "component": "testimonial.featured-section"
    },
    "partners": {
      "type": "component",
      "repeatable": false,
      "component": "testimonial.partners-section"
    },
    "partnerCta": {
      "type": "component",
      "repeatable": false,
      "component": "testimonial.partner-cta"
    },
    "faq": {
      "type": "component",
      "repeatable": false,
      "component": "testimonial.faq-section"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
