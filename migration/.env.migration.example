# WordPress → Strapi migration environment.
# IMPORTANT: this tool loads `.env.migration` (NOT `.env`) — copy this file:
#   cp .env.migration.example .env.migration
# .env.migration is gitignored — never commit real credentials.

# ── Isolated source profile ─────────────────────────────────────────────────
MIGRATION_PROFILE=india
MIGRATION_STATE_DIR=.state/india
MIGRATION_SITE_CONFIGURATION_FILE=profiles/india/site-configuration.json
MIGRATION_EXCLUSIONS_FILE=excluded-stores.csv
# Footer country-switcher links come from profiles/footer-countries.json. The
# migration automatically removes SOURCE_COUNTRY_CODE, so every site shows all
# other registered country sites. Profile-only footer content such as Google
# Preferred lives in profiles/<profile>/footer-settings.json.
#
# DANGEROUS OVERRIDE — leave unset. Preflight and phase 13 abort when the
# target database's country_code differs from SOURCE_COUNTRY_CODE, which is the
# guard that stops a mis-pointed run from overwriting another country's data.
# MIGRATION_ALLOW_COUNTRY_SWITCH=true
SOURCE_COUNTRY_CODE=IN
SOURCE_LOCALE=en-IN
SOURCE_CURRENCY_CODE=INR
SOURCE_TIMEZONE=Asia/Kolkata
SOURCE_INTERNAL_HOSTS=www.couponzguru.com,couponzguru.com
TARGET_INTERNAL_HOSTS=www.couponzguru.com,couponzguru.com
# Optional source assertions. USA defaults are 7162 Stores, 10360 attachments,
# and zero Deals; set explicit values for another source profile.
EXPECTED_STORE_COUNT=
EXPECTED_ATTACHMENT_COUNT=
EXPECTED_DEAL_COUNT=
EXPECTED_HERO_BANNER_COUNT=
EXPECTED_FEATURED_STORE_COUNT=

# ── WordPress MySQL source (reached through the SSH tunnel below) ────────────
# Host as seen FROM the SSH server — usually 127.0.0.1 when MySQL runs there.
WP_DB_HOST=127.0.0.1
WP_DB_PORT=3306
WP_DB_USER=root
WP_DB_PASSWORD=
# Required — the WordPress database name.
WP_DB_NAME=wordpress
# Validated before the first query; USA uses wp_dda10ab629_.
WP_TABLE_PREFIX=wp_
# Local copy of wp-content/uploads — media phases read files from here.
# Default: ../wordpress/wp-content/uploads (relative to migration/).
WP_UPLOADS_DIR=../wordpress/wp-content/uploads

# Header/footer scripts are intentionally excluded unless separately reviewed.
IMPORT_WP_TRACKING_SCRIPTS=false

# ── SSH tunnel to the WordPress server (leave SSH_HOST empty for a local DB) ─
SSH_HOST=
SSH_PORT=22
SSH_USER=root
# Key auth: path below AND/OR a loaded ssh-agent (SSH_AUTH_SOCK from your
# shell is tried automatically). Passphrase-protected keys: set the
# passphrase here or `ssh-add --apple-use-keychain` the key first.
SSH_PRIVATE_KEY_PATH=~/.ssh/id_ed25519
SSH_PRIVATE_KEY_PASSPHRASE=
# Optional MITM pin: expected host-key fingerprint ("SHA256:...").
# Get it with: ssh-keyscan -t ed25519 <host> | ssh-keygen -lf -
SSH_HOST_FINGERPRINT=

# ── Strapi PostgreSQL target (writes DIRECTLY into Strapi's database) ────────
PG_CONNECTION_STRING=postgres://strapi:change-me@127.0.0.1:5432/strapi
# Managed-Postgres TLS: path to the provider CA cert; empty for local.
PG_CA_CERT_PATH=
PG_SSL_REJECT_UNAUTHORIZED=true

# ── S3 media target (MUST match Strapi's upload provider settings) ──────────
S3_ACCESS_KEY_ID=
S3_ACCESS_SECRET=
S3_BUCKET=
S3_REGION=ap-south-1
# Custom endpoint for S3-compatible providers; empty for AWS S3.
S3_ENDPOINT=
# Public CDN base written into file URLs (match Strapi's S3_BASE_URL),
# e.g. https://media.couponzguru.com
S3_BASE_URL=https://media.couponzguru.com
# Key prefix inside the bucket (match Strapi's S3_ROOT_PATH).
S3_ROOT_PATH=uploads

# ── Product Deal background removal ──────────────────────────────────────────
# Required by Phase 08/08a when an opaque Deal image must be processed.
FAL_KEY=
FAL_BACKGROUND_REMOVAL_CONCURRENCY=2
FAL_BACKGROUND_REMOVAL_TIMEOUT_MS=120000
FAL_BACKGROUND_REMOVAL_MAX_ATTEMPTS=3

# ── Tuning ───────────────────────────────────────────────────────────────────
# Rows per batch for DB reads/writes.
BATCH_SIZE=5000
# Parallel image optimize+upload workers in the media phases.
MEDIA_CONCURRENCY=10
# Logger verbosity: debug | info | warn | error
LOG_LEVEL=info
