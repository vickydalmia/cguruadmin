# ── Source (USA WordPress DB + uploads; never the india host) ──
SSH_HOST=usa-wordpress.example.com
SSH_PORT=22
SSH_USER=usa_wordpress_user
SSH_PRIVATE_KEY_PATH=~/.ssh/id_ed25519
SSH_HOST_FINGERPRINT=SHA256:replace_with_verified_host_fingerprint

# WordPress MySQL Connection
WP_DB_HOST=127.0.0.1
WP_DB_PORT=3306
WP_DB_USER=usa_wordpress_db_user
WP_DB_PASSWORD=replace_with_wordpress_db_password
WP_DB_NAME=usa_wordpress_db

MIGRATION_PROFILE=usa
MIGRATION_STATE_DIR=.state/usa
MIGRATION_SITE_CONFIGURATION_FILE=profiles/usa/site-configuration.json
MIGRATION_EXCLUSIONS_FILE=profiles/usa/excluded-stores.csv
# Footer country links come from the shared profiles/footer-countries.json and
# automatically exclude USA. Add a site there once to expose it on every other
# deployment; each referenced flag must exist in migration/assets/footer/.
WP_TABLE_PREFIX=wp_dda10ab629_
SOURCE_COUNTRY_CODE=US
SOURCE_LOCALE=en-US
SOURCE_CURRENCY_CODE=USD
SOURCE_TIMEZONE=America/New_York
SOURCE_INTERNAL_HOSTS=couponzguruusa.com,www.couponzguruusa.com
TARGET_INTERNAL_HOSTS=
EXPECTED_STORE_COUNT=7162
EXPECTED_ATTACHMENT_COUNT=10360
EXPECTED_DEAL_COUNT=0
EXPECTED_HERO_BANNER_COUNT=5
EXPECTED_FEATURED_STORE_COUNT=8
IMPORT_WP_TRACKING_SCRIPTS=false


# Strapi PostgreSQL Connection
# PG_CONNECTION_STRING=postgresql://target_user:target_password@target-db.example.com:25060/target_db
# PG_CA_CERT_PATH=/absolute/path/to/target-ca-certificate.crt
# PG_SSL_REJECT_UNAUTHORIZED=true
# Defaults to 10 so two live Strapi pools (5 each) remain below the current
# managed-Postgres 22-backend limit. Raise only with verified DB headroom.
# PG_POOL_MAX=10
# S3 Upload Configuration
S3_BUCKET=replace_with_usa_media_bucket
S3_REGION=us-east-2
S3_ACCESS_KEY_ID=replace_with_s3_access_key_id
S3_ACCESS_SECRET=replace_with_s3_secret_access_key
S3_BASE_URL=https://media.couponzguruusa.com
S3_ROOT_PATH=uploads

# WordPress uploads directory (local path)
WP_UPLOADS_DIR=../wordpress/wp-content/uploads

# Migration settings
BATCH_SIZE=5000
MEDIA_CONCURRENCY=10
TAXONOMY_CONCURRENCY=8
COUPON_CONCURRENCY=8
COUPON_BATCH_SIZE=250
COUPON_BATCH_CONCURRENCY=4
LOG_LEVEL=info

FAL_KEY=replace_with_fal_api_key
FAL_BACKGROUND_REMOVAL_CONCURRENCY=2
FAL_BACKGROUND_REMOVAL_TIMEOUT_MS=120000
FAL_BACKGROUND_REMOVAL_MAX_ATTEMPTS=3
