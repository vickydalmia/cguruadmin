# Malaysia migration overlay. Copy the generic template to `.env.migration`,
# then apply these profile-specific values and replace every credential/target.
#
# Source facts (MY dump of 2026-09-08, my/2026-09-08-18-04-41-coupongurumalaysia-wp-*.sql):
# theme cguru-v2 with the canonical India-style ACF keys (`code`, `link`,
# `image`, `offer_type`, `popular_coupon`; `store_cat_image`, `store_image_alt`,
# `store_short_description`). No source-field aliases are needed. Coupon
# `image` is a full couponzguru.my upload URL, store logos are attachment IDs.

MIGRATION_PROFILE=my
MIGRATION_STATE_DIR=.state/my
MIGRATION_SITE_CONFIGURATION_FILE=profiles/my/site-configuration.json
# The only non-catalog term is `Uncategorized`, which the importer already
# excludes. No retired-store CSV is needed unless the operator supplies one.
MIGRATION_EXCLUSIONS_FILE=
# REQUIRED: MY has no ACF choose_type. Build this workbook (sheet
# `Classification`, columns Name / Slug / Classification) from my/my-stores.csv.
# Unmatched SQL slugs default to Store.
MIGRATION_CLASSIFICATION_FILE=my/CouponzGuru_MY_Taxonomy_Classification.xlsx

SOURCE_COUNTRY_CODE=MY
SOURCE_LOCALE=en-MY
SOURCE_CURRENCY_CODE=MYR
SOURCE_TIMEZONE=Asia/Kuala_Lumpur
SOURCE_INTERNAL_HOSTS=couponzguru.my,www.couponzguru.my
TARGET_INTERNAL_HOSTS=

WP_DB_HOST=127.0.0.1
WP_DB_PORT=3306
WP_DB_USER=my_wordpress_db_user
WP_DB_PASSWORD=replace_with_wordpress_db_password
WP_DB_NAME=my_wordpress_db
# The MY dump uses this prefix.
WP_TABLE_PREFIX=wp_288a16b6cd_
# The MY uploads tree sits at the top of the my/ folder.
WP_UPLOADS_DIR=my/uploads

# Source inventory recorded from the 2026-09-08 dump: 561 category terms
# (560 with a logo), 1,583 attachments, 2,141 published posts, no `is_deal`
# rows, and 5 `options_slider_features` rows with the slider switched on.
# Set EXPECTED_STORE_COUNT once the classification workbook is final (561
# terms minus Uncategorized and non-Store rows).
EXPECTED_STORE_COUNT=
EXPECTED_ATTACHMENT_COUNT=1583
EXPECTED_DEAL_COUNT=0
EXPECTED_HERO_BANNER_COUNT=5
IMPORT_WP_TRACKING_SCRIPTS=false

# Never inherit another country's target database or media bucket.
PG_CONNECTION_STRING=postgresql://target_user:target_password@target-db.example.com:25060/target_db
PG_CA_CERT_PATH=
PG_SSL_REJECT_UNAUTHORIZED=true
S3_BUCKET=replace_with_my_media_bucket
S3_REGION=replace_with_my_bucket_region
S3_ACCESS_KEY_ID=replace_with_s3_access_key_id
S3_ACCESS_SECRET=replace_with_s3_secret_access_key
S3_BASE_URL=https://media.couponzguru.my
S3_ROOT_PATH=uploads
