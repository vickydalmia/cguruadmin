# UAE migration overlay. Copy the generic template to `.env.migration`, then
# apply these profile-specific values and replace every credential/target.

MIGRATION_PROFILE=ae
MIGRATION_STATE_DIR=.state/ae
MIGRATION_SITE_CONFIGURATION_FILE=profiles/ae/site-configuration.json
MIGRATION_EXCLUSIONS_FILE=profiles/ae/excluded-stores.csv
MIGRATION_CLASSIFICATION_FILE=uae/CouponzGuru_UAE_Taxonomy_Classification.xlsx

SOURCE_COUNTRY_CODE=AE
SOURCE_LOCALE=en-AE
SOURCE_CURRENCY_CODE=AED
SOURCE_TIMEZONE=Asia/Dubai
SOURCE_INTERNAL_HOSTS=couponzguru.ae,www.couponzguru.ae
TARGET_INTERNAL_HOSTS=

WP_DB_HOST=127.0.0.1
WP_DB_PORT=3306
WP_DB_USER=uae_wordpress_db_user
WP_DB_PASSWORD=replace_with_wordpress_db_password
WP_DB_NAME=uae_wordpress_db
WP_TABLE_PREFIX=wp_replace_with_uae_prefix_
WP_UPLOADS_DIR=uae/www.couponzguru.ae/uploads

# Set these only after recording the current UAE source inventory.
EXPECTED_STORE_COUNT=
EXPECTED_ATTACHMENT_COUNT=
EXPECTED_DEAL_COUNT=
EXPECTED_HERO_BANNER_COUNT=

# Never inherit another country's target database or media bucket.
PG_CONNECTION_STRING=postgresql://target_user:target_password@target-db.example.com:25060/target_db
PG_CA_CERT_PATH=
PG_SSL_REJECT_UNAUTHORIZED=true
S3_BUCKET=replace_with_uae_media_bucket
S3_REGION=replace_with_uae_bucket_region
S3_ACCESS_KEY_ID=replace_with_s3_access_key_id
S3_ACCESS_SECRET=replace_with_s3_secret_access_key
S3_BASE_URL=https://media.couponzguru.ae
S3_ROOT_PATH=uploads
