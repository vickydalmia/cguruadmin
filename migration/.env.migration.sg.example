# Singapore migration overlay. Copy the generic template to `.env.migration`,
# then apply these profile-specific values and replace every credential/target.
#
# Source facts (SG dump of 2026-09-06): the WordPress theme is the same cguru-v2,
# but coupon code/link/image live under `_cmb_coupon_code`,
# `_cmb_affiliate_link`, `_cmb_coupon_image` and the store logo under
# `store_image`. The migration reads those aliases automatically
# (src/utils/wp-source-fields.ts); nothing to configure here.

MIGRATION_PROFILE=sg
MIGRATION_STATE_DIR=.state/sg
MIGRATION_SITE_CONFIGURATION_FILE=profiles/sg/site-configuration.json
# Drops the `Deals` bucket term (246 published posts, 224 with no store).
MIGRATION_EXCLUSIONS_FILE=profiles/sg/excluded-stores.csv
# REQUIRED: SG has no ACF choose_type. Build this workbook (sheet
# `Classification`, columns Name / Slug / Classification) from sg/sg-stores.csv.
# Unmatched SQL slugs default to Store.
MIGRATION_CLASSIFICATION_FILE=sg/CouponzGuru_SG_Taxonomy_Classification.xlsx

SOURCE_COUNTRY_CODE=SG
SOURCE_LOCALE=en-SG
SOURCE_CURRENCY_CODE=SGD
SOURCE_TIMEZONE=Asia/Singapore
SOURCE_INTERNAL_HOSTS=couponzguru.sg,www.couponzguru.sg
TARGET_INTERNAL_HOSTS=

WP_DB_HOST=127.0.0.1
WP_DB_PORT=3306
WP_DB_USER=sg_wordpress_db_user
WP_DB_PASSWORD=replace_with_wordpress_db_password
WP_DB_NAME=sg_wordpress_db
# The SG dump (sg/cgurusg/wp_r9b3ct0_commentmeta.sql — a full 21-table dump
# despite its name) uses this prefix.
WP_TABLE_PREFIX=wp_r9b3ct0_
# The SG uploads tree sits inside the WordPress install, not at the top level.
WP_UPLOADS_DIR=sg/cgurusg/public/wp-content/uploads

# Source inventory recorded from the 2026-09-06 dump. Set EXPECTED_STORE_COUNT
# once the classification workbook is final (802 terms minus excluded and
# non-Store rows).
EXPECTED_STORE_COUNT=
EXPECTED_ATTACHMENT_COUNT=2426
EXPECTED_DEAL_COUNT=0
EXPECTED_HERO_BANNER_COUNT=0

# Never inherit another country's target database or media bucket.
PG_CONNECTION_STRING=postgresql://target_user:target_password@target-db.example.com:25060/target_db
PG_CA_CERT_PATH=
PG_SSL_REJECT_UNAUTHORIZED=true
S3_BUCKET=replace_with_sg_media_bucket
S3_REGION=replace_with_sg_bucket_region
S3_ACCESS_KEY_ID=replace_with_s3_access_key_id
S3_ACCESS_SECRET=replace_with_s3_secret_access_key
S3_BASE_URL=https://media.couponzguru.sg
S3_ROOT_PATH=uploads
